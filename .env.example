# 복사해서 .env.local 로 사용하세요. (.env.local 은 git 에 올라가지 않습니다)

# 개발자 모드. 출시 환경에서는 false 로 두거나 줄을 지우면 개발자 모드 버튼과 모든 개발자 기능이 사라집니다.
DANBI_DEV_MODE=true

# 개발자 모드 잠금 해제 비밀번호. 비워두면 개발자 기능을 열 수 없습니다.
# 공개 저장소이므로 실제 값은 절대 이 파일에 적지 마세요.
DANBI_DEV_PASSWORD=

# SQLite 파일 경로 (기본값: ./data/danbi.db)
# DANBI_DB_PATH=./data/danbi.db
